{
  "clientId": "ceerat-admin-ui",
  "name": "CEERAT Admin UI",
  "enabled": true,
  "publicClient": true,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "consentRequired": true,
  "redirectUris": [
    "http://localhost:3010/oauth/callback",
    "http://127.0.0.1:3010/oauth/callback",
    "https://ceerat-admin-ui.onrender.com/oauth/callback"
  ],
  "webOrigins": [
    "http://localhost:3010",
    "http://127.0.0.1:3010",
    "https://ceerat-admin-ui.onrender.com"
  ],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "access.token.lifespan": "600"
  },
  "protocolMappers": [
    {
      "name": "subject",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-sub-mapper",
      "consentRequired": false,
      "config": {
        "access.token.claim": "true",
        "id.token.claim": "true"
      }
    },
    {
      "name": "CEERAT API audience",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "consentRequired": false,
      "config": {
        "included.custom.audience": "ceerat-api",
        "access.token.claim": "true"
      }
    }
  ],
  "defaultClientScopes": [
    "profile",
    "email"
  ],
  "optionalClientScopes": [
    "ceerat.admin.read",
    "ceerat.admin.users.read",
    "ceerat.admin.users.write",
    "ceerat.admin.rbac.read",
    "ceerat.admin.rbac.write",
    "ceerat.admin.operations.write"
  ],
  "clientAuthenticatorType": "none"
}
