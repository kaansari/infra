{
  "clientId": "ceerat-grpc-dev",
  "name": "CEERAT Direct gRPC Development",
  "description": "Native direct-gRPC development client; loopback callbacks only",
  "enabled": true,
  "publicClient": true,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "consentRequired": true,
  "redirectUris": ["http://127.0.0.1:*", "http://localhost:*"],
  "webOrigins": [],
  "attributes": {"pkce.code.challenge.method": "S256", "access.token.lifespan": "600"},
  "protocolMappers": [
    {
      "name": "subject",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-sub-mapper",
      "consentRequired": false,
      "config": {"access.token.claim": "true", "id.token.claim": "true"}
    },
    {
      "name": "CEERAT API audience",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "consentRequired": false,
      "config": {"included.custom.audience": "ceerat-api", "access.token.claim": "true"}
    }
  ],
  "defaultClientScopes": ["profile", "email"],
  "optionalClientScopes": [
    "offline_access", "ceerat.profile.read", "ceerat.profile.write",
    "ceerat.connections.read", "ceerat.connections.revoke",
    "ceerat.products.read", "ceerat.products.cart.read", "ceerat.products.cart.write",
    "ceerat.orders.read", "ceerat.orders.checkout", "ceerat.orders.write",
    "ceerat.preferences.read", "ceerat.preferences.write"
  ]
}
