{
  "clientId": "ceerat-mcp-codex-dev",
  "name": "CEERAT MCP Codex Development",
  "description": "Native development client; loopback callbacks only",
  "enabled": true,
  "publicClient": true,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "consentRequired": true,
  "redirectUris": ["http://127.0.0.1:*", "http://localhost:*"],
  "webOrigins": [],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "access.token.lifespan": "600"
  },
  "protocolMappers": [
    {
      "name": "CEERAT user id",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usermodel-attribute-mapper",
      "consentRequired": false,
      "config": {
        "user.attribute": "ceerat_user_id",
        "claim.name": "ceerat_user_id",
        "jsonType.label": "String",
        "access.token.claim": "true",
        "id.token.claim": "true",
        "userinfo.token.claim": "true"
      }
    },
    {
      "name": "CEERAT MCP audience",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-audience-mapper",
      "consentRequired": false,
      "config": {
        "included.custom.audience": "https://ceerat-agent-gateway.onrender.com/mcp",
        "access.token.claim": "true"
      }
    }
  ],
  "defaultClientScopes": [
    "profile",
    "email",
    "ceerat.profile.read",
    "ceerat.profile.write",
    "ceerat.connections.read",
    "ceerat.connections.revoke"
  ],
  "optionalClientScopes": [
    "offline_access",
    "ceerat.products.read",
    "ceerat.products.cart.read",
    "ceerat.products.cart.write"
  ]
}
