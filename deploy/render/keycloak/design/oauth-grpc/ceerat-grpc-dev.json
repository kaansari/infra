{
  "clientId": "ceerat-grpc-dev",
  "name": "CEERAT direct gRPC development",
  "description": "Planned native local direct-gRPC OAuth client; PR 01 design only",
  "enabled": true,
  "publicClient": true,
  "standardFlowEnabled": true,
  "implicitFlowEnabled": false,
  "directAccessGrantsEnabled": false,
  "serviceAccountsEnabled": false,
  "consentRequired": true,
  "redirectUris": [
    "http://127.0.0.1:*",
    "http://localhost:*"
  ],
  "webOrigins": [],
  "attributes": {
    "pkce.code.challenge.method": "S256",
    "access.token.lifespan": "600"
  },
  "defaultClientScopes": [
    "profile",
    "email",
    "ceerat-api-audience"
  ],
  "optionalClientScopes": [
    "offline_access"
  ]
}
