# Copy to public.env; public.env is ignored by git.
CEERAT_MCP_DOMAIN=agents.example.com
CEERAT_USER_SERVICE_ADDR=host.docker.internal:50051
CEERAT_USER_SERVICE_TLS_MODE=mtls
# Mount these files into the gateway container; never put private keys in this file.
CEERAT_USER_SERVICE_TLS_CA_FILE=/run/secrets/ceerat_grpc_ca.pem
CEERAT_USER_SERVICE_TLS_CERT_FILE=/run/secrets/ceerat_gateway.crt
CEERAT_USER_SERVICE_TLS_KEY_FILE=/run/secrets/ceerat_gateway.key
CEERAT_USER_SERVICE_TLS_SERVER_NAME=ceerat-user-service
CEERAT_OAUTH_ISSUER=https://auth.example.com/realms/ceerat
CEERAT_OAUTH_JWKS_URL=https://auth.example.com/realms/ceerat/protocol/openid-connect/certs
CEERAT_USER_ID_CLAIM=ceerat_user_id
CEERAT_CLIENT_ID_CLAIM=azp
CEERAT_GATEWAY_DATABASE_URL=postgres://user:password@database:5432/ceerat?sslmode=require
