# Copy to public.env; public.env is ignored by git.
CEERAT_MCP_DOMAIN=agents.example.com
CEERAT_USER_SERVICE_ADDR=host.docker.internal:50051
CEERAT_OAUTH_ISSUER=https://auth.example.com/realms/ceerat
CEERAT_OAUTH_JWKS_URL=https://auth.example.com/realms/ceerat/protocol/openid-connect/certs
CEERAT_USER_ID_CLAIM=ceerat_user_id
CEERAT_CLIENT_ID_CLAIM=azp
